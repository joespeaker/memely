# Core
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://memely:memely@localhost:5432/memely

# Storage/CDN
STORAGE_PROVIDER=s3
S3_BUCKET=memely-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=https://cdn.example.com

# Auth/Security
JWT_SECRET=
SESSION_SECRET=
CSRF_SECRET=
RATE_LIMIT_PER_MINUTE=120

# Queue/Workers
QUEUE_URL=redis://localhost:6379
IMAGE_PROCESSING_CONCURRENCY=4
MODERATION_PIPELINE_CONCURRENCY=2

# Safety
UPLOAD_SCAN_PROVIDER=clamav
UPLOAD_MAX_MB=10

# DMCA/Compliance
DMCA_EMAIL=dmca@example.com
ABUSE_EMAIL=abuse@example.com

# Analytics
ANALYTICS_WRITE_KEY=
